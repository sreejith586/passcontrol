// Minimal MVP schema for shared foundations and existing modules.
// Extend with full frozen schema as needed.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ChecklistItemSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

// ---- Identity & RBAC ----
model User {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique
  name         String
  passwordHash String?   @map("password_hash")
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz

  roleAssignments       UserRoleAssignment[]
  auditLogs             AuditLog[]           @relation("AuditActor")
  assignedAlerts        AlertEvent[]         @relation("AssignedTo")
  ownedSchedules        ChecklistSchedule[]  @relation("ScheduleOwner")
  assignedChecklistRuns ChecklistRun[]        @relation("ChecklistRunAssignedToUser")
  performedChecklistRuns ChecklistRun[]        @relation("ChecklistRunPerformedByUser")
  passwordSetupTokens   PasswordSetupToken[]

  @@map("users")
}

model PasswordSetupToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @map("token_hash")
  expiresAt DateTime @map("expires_at") @db.Timestamptz
  usedAt    DateTime? @map("used_at") @db.Timestamptz
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tokenHash])
  @@index([userId])
  @@map("password_setup_tokens")
}

model Organization {
  id                           String    @id @default(uuid()) @db.Uuid
  name                         String
  requireResolutionNoteOnResolve Boolean  @default(false) @map("require_resolution_note_on_resolve")
  requireReopenNoteOnReopen      Boolean  @default(false) @map("require_reopen_note_on_reopen")
  createdAt                    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                    DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt                    DateTime? @map("deleted_at") @db.Timestamptz

  auditLogs                    AuditLog[]                    @relation("AuditOrg")
  brands                       Brand[]
  locations                    Location[]
  users                        UserRoleAssignment[]
  files                        File[]
  attachments                  Attachment[]
  incidents                    Incident[]
  tasks                        Task[]
  temperaturePolicies          TemperaturePolicy[]
  temperatureReadings          TemperatureReading[]
  alertEvents                  AlertEvent[]
  alertEventActivities         AlertEventActivity[]
  alertEventComments           AlertEventComment[]
  alertSlaPolicies             AlertSlaPolicy[]
  checklistRuns                ChecklistRun[]
  checklistTemplates           ChecklistTemplate[]
  checklistTemplateSections    ChecklistTemplateSection[]
  checklistTemplateItems       ChecklistTemplateItem[]
  checklistSchedules           ChecklistSchedule[]
  checklistRunSectionSnapshots ChecklistRunSectionSnapshot[]
  checklistRunItemSnapshots    ChecklistRunItemSnapshot[]
  Zone                         Zone[]
  Asset                        Asset[]

  @@map("organizations")
}

model Brand {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id])
  locations    Location[]

  @@map("brands")
}

model Location {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  brandId        String   @map("brand_id") @db.Uuid
  name           String
  timezone       String
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id])
  brand        Brand        @relation(fields: [brandId], references: [id])
  zones        Zone[]
  assets       Asset[]
  incidents    Incident[]
  tasks        Task[]

  @@map("locations")
}

model Zone {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  locationId     String   @map("location_id") @db.Uuid
  name           String
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id])
  location     Location     @relation(fields: [locationId], references: [id])
  assets       Asset[]

  @@map("zones")
}

model Asset {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  locationId     String   @map("location_id") @db.Uuid
  zoneId         String?  @map("zone_id") @db.Uuid
  name           String
  assetType      String   @map("asset_type")
  status         String   @default("ACTIVE")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id])
  location     Location     @relation(fields: [locationId], references: [id])
  zone         Zone?        @relation(fields: [zoneId], references: [id])
  attachments  Attachment[]

  @@map("assets")
}

model Role {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String?  @map("organization_id") @db.Uuid
  name           String
  key            String
  scope          String
  isSystem       Boolean  @default(false) @map("is_system")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz

  permissions RolePermission[]
  assignments UserRoleAssignment[]

  @@map("roles")
}

model Permission {
  id        String   @id @default(uuid()) @db.Uuid
  key       String   @unique
  name      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  id           String @id @default(uuid()) @db.Uuid
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model UserRoleAssignment {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  roleId         String   @map("role_id") @db.Uuid
  brandId        String?  @map("brand_id") @db.Uuid
  locationId     String?  @map("location_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  user         User         @relation(fields: [userId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])
  role         Role         @relation(fields: [roleId], references: [id])

  @@map("user_role_assignments")
}

// ---- Files & Attachments ----
model File {
  id               String   @id @default(uuid()) @db.Uuid
  organizationId   String?  @map("organization_id") @db.Uuid
  bucket           String
  objectKey        String   @map("object_key")
  fileName         String   @map("file_name")
  mimeType         String   @map("mime_type")
  sizeBytes        Int      @map("size_bytes")
  checksum         String?
  uploadedByUserId String?  @map("uploaded_by_user_id") @db.Uuid
  uploadedAt       DateTime @default(now()) @map("uploaded_at") @db.Timestamptz
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz

  organization Organization? @relation(fields: [organizationId], references: [id])
  attachments  Attachment[]

  @@map("files")
}

model Attachment {
  id                         String   @id @default(uuid()) @db.Uuid
  organizationId             String?  @map("organization_id") @db.Uuid
  fileId                     String   @map("file_id") @db.Uuid
  incidentId                 String?  @map("incident_id") @db.Uuid
  taskId                     String?  @map("task_id") @db.Uuid
  checklistRunId             String?  @map("checklist_run_id") @db.Uuid
  checklistRunItemSnapshotId String?  @map("checklist_run_item_snapshot_id") @db.Uuid
  assetId                    String?  @map("asset_id") @db.Uuid
  attachmentType             String   @map("attachment_type")
  purpose                    String?
  createdAt                  DateTime @default(now()) @map("created_at") @db.Timestamptz

  organization             Organization?             @relation(fields: [organizationId], references: [id])
  file                     File                      @relation(fields: [fileId], references: [id])
  asset                    Asset?                    @relation(fields: [assetId], references: [id])
  checklistRunItemSnapshot ChecklistRunItemSnapshot? @relation(fields: [checklistRunItemSnapshotId], references: [id])

  @@index([checklistRunItemSnapshotId])
  @@map("attachments")
}

// ---- Temperature ----
model TemperaturePolicy {
  id                 String   @id @default(uuid()) @db.Uuid
  organizationId     String   @map("organization_id") @db.Uuid
  brandId            String?  @map("brand_id") @db.Uuid
  locationId         String?  @map("location_id") @db.Uuid
  zoneId             String?  @map("zone_id") @db.Uuid
  assetId            String?  @map("asset_id") @db.Uuid
  name               String
  minTemp            Float    @map("min_temp")
  maxTemp            Float    @map("max_temp")
  unit               String
  breachGraceSeconds Int?     @map("breach_grace_seconds")
  isActive           Boolean  @default(true) @map("is_active")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id])

  @@map("temperature_policies")
}

model TemperatureReading {
  id                         String   @id @default(uuid()) @db.Uuid
  organizationId             String   @map("organization_id") @db.Uuid
  brandId                    String?  @map("brand_id") @db.Uuid
  locationId                 String?  @map("location_id") @db.Uuid
  zoneId                     String?  @map("zone_id") @db.Uuid
  assetId                    String?  @map("asset_id") @db.Uuid
  policyId                   String?  @map("policy_id") @db.Uuid
  checklistRunId             String?  @map("checklist_run_id") @db.Uuid
  checklistRunItemSnapshotId String?  @map("checklist_run_item_snapshot_id") @db.Uuid
  sourceType                 String   @map("source_type")
  readingValue               Float    @map("reading_value")
  unit                       String
  recordedAt                 DateTime @default(now()) @map("recorded_at") @db.Timestamptz
  recordedByUserId           String?  @map("recorded_by_user_id") @db.Uuid
  isBreach                   Boolean  @default(false) @map("is_breach")
  breachType                 String   @map("breach_type")
  rawPayloadJson             Json?    @map("raw_payload_json")
  createdAt                  DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                  DateTime @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id])

  @@map("temperature_readings")
}

// ---- Alert Events ----
enum AlertStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

enum AlertEventActivityType {
  CREATED
  ACKNOWLEDGED
  RESOLVED
  REOPENED
  ASSIGNED
  UNASSIGNED
  REASSIGNED
}

enum AlertEventCommentType {
  COMMENT
  RESOLUTION_NOTE
  REOPEN_NOTE
}

model AlertSlaPolicy {
  id                      String   @id @default(uuid()) @db.Uuid
  organizationId          String   @map("organization_id") @db.Uuid
  brandId                 String?  @map("brand_id") @db.Uuid
  locationId              String?  @map("location_id") @db.Uuid
  zoneId                  String?  @map("zone_id") @db.Uuid
  severity                String
  acknowledgeWithinMinutes Int     @map("acknowledge_within_minutes")
  resolveWithinMinutes    Int      @map("resolve_within_minutes")
  isActive                Boolean  @default(true) @map("is_active")
  createdAt               DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt               DateTime @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId, severity, isActive])
  @@index([organizationId, locationId, severity, isActive])
  @@index([organizationId, brandId, severity, isActive])
  @@map("alert_sla_policies")
}

model AlertEvent {
  id                       String    @id @default(uuid()) @db.Uuid
  organizationId           String    @map("organization_id") @db.Uuid
  brandId                  String?   @map("brand_id") @db.Uuid
  locationId               String?   @map("location_id") @db.Uuid
  zoneId                   String?   @map("zone_id") @db.Uuid
  assetId                  String?   @map("asset_id") @db.Uuid
  sourceType               String    @map("source_type")
  sourceId                 String    @map("source_id")
  type                     String
  status                   AlertStatus @default(OPEN)
  severity                 String?
  acknowledgeWithinMinutes Int       @default(60) @map("acknowledge_within_minutes")
  resolveWithinMinutes     Int       @default(240) @map("resolve_within_minutes")
  payloadJson              Json?     @map("payload_json")
  triggeredAt              DateTime  @default(now()) @map("triggered_at") @db.Timestamptz
  acknowledgedAt           DateTime? @map("acknowledged_at") @db.Timestamptz
  acknowledgedByUserId     String?   @map("acknowledged_by_user_id") @db.Uuid
  resolvedAt               DateTime? @map("resolved_at") @db.Timestamptz
  resolvedByUserId         String?   @map("resolved_by_user_id") @db.Uuid
  resolutionNote           String?   @map("resolution_note")
  createdAt                DateTime  @default(now()) @map("created_at") @db.Timestamptz
  assignedToUserId         String?   @map("assigned_to_user_id") @db.Uuid
  assignedAt               DateTime? @map("assigned_at") @db.Timestamptz
  assignedByUserId         String?   @map("assigned_by_user_id") @db.Uuid

  organization   Organization        @relation(fields: [organizationId], references: [id])
  assignedToUser User?               @relation("AssignedTo", fields: [assignedToUserId], references: [id])
  activities     AlertEventActivity[]
  comments       AlertEventComment[]

  @@map("alert_events")
}

model AlertEventActivity {
  id                   String                 @id @default(cuid())
  organizationId       String                 @map("organization_id") @db.Uuid
  alertEventId         String                 @map("alert_event_id") @db.Uuid
  type                 AlertEventActivityType
  actorUserId          String?                @map("actor_user_id") @db.Uuid
  fromStatus           AlertStatus?           @map("from_status")
  toStatus             AlertStatus?           @map("to_status")
  fromAssignedToUserId String?                @map("from_assigned_to_user_id") @db.Uuid
  toAssignedToUserId   String?                @map("to_assigned_to_user_id") @db.Uuid
  comment              String?
  metadata             Json?                  @map("metadata")
  createdAt            DateTime               @default(now()) @map("created_at") @db.Timestamptz

  alertEvent   AlertEvent   @relation(fields: [alertEventId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId, alertEventId, createdAt])
  @@index([alertEventId, createdAt])
  @@map("alert_event_activities")
}

model AlertEventComment {
  id             String                @id @default(cuid())
  organizationId String                @map("organization_id") @db.Uuid
  alertEventId   String                @map("alert_event_id") @db.Uuid
  authorUserId   String?               @map("author_user_id") @db.Uuid
  type           AlertEventCommentType
  body           String
  createdAt      DateTime              @default(now()) @map("created_at") @db.Timestamptz

  alertEvent   AlertEvent   @relation(fields: [alertEventId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId, alertEventId, createdAt])
  @@index([alertEventId, createdAt])
  @@map("alert_event_comments")
}

// ---- Incidents & Tasks (referenced by attachments) ----
model Incident {
  id               String   @id @default(uuid()) @db.Uuid
  organizationId   String   @map("organization_id") @db.Uuid
  brandId          String?  @map("brand_id") @db.Uuid
  locationId       String?  @map("location_id") @db.Uuid
  zoneId           String?  @map("zone_id") @db.Uuid
  assetId          String?  @map("asset_id") @db.Uuid
  category         String
  severity         String
  title            String
  description      String?
  status           String   @default("OPEN")
  reportedAt       DateTime @default(now()) @map("reported_at") @db.Timestamptz
  reportedByUserId String?  @map("reported_by_user_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id])
  location     Location?    @relation(fields: [locationId], references: [id])

  @@map("incidents")
}

model Task {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  brandId        String?  @map("brand_id") @db.Uuid
  locationId     String   @map("location_id") @db.Uuid
  zoneId         String?  @map("zone_id") @db.Uuid
  title          String
  description    String?
  status         String   @default("OPEN")
  sourceType     String   @map("source_type")
  sourceId       String?  @map("source_id")
  incidentId     String?  @map("incident_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id])
  location     Location     @relation(fields: [locationId], references: [id])

  @@map("tasks")
}

// ---- Checklist (referenced by attachments) ----
model ChecklistTemplate {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  templateKey    String    @map("template_key")
  version        Int
  name           String
  description    String?
  brandId        String?   @map("brand_id") @db.Uuid
  locationId     String?   @map("location_id") @db.Uuid
  zoneId         String?   @map("zone_id") @db.Uuid
  status         String    @default("DRAFT")
  isLatest       Boolean   @default(false) @map("is_latest")
  publishedAt    DateTime? @map("published_at") @db.Timestamptz
  archivedAt     DateTime? @map("archived_at") @db.Timestamptz
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization               @relation(fields: [organizationId], references: [id])
  sections     ChecklistTemplateSection[]
  schedules    ChecklistSchedule[]
  items        ChecklistTemplateItem[]

  @@unique([organizationId, templateKey, version])
  @@index([organizationId, templateKey, isLatest])
  @@index([organizationId, status])
  @@index([organizationId, brandId, locationId, zoneId])
  @@map("checklist_templates")
}

model ChecklistTemplateSection {
  id                  String   @id @default(uuid()) @db.Uuid
  organizationId      String   @map("organization_id") @db.Uuid
  checklistTemplateId String   @map("checklist_template_id") @db.Uuid
  title               String
  description         String?
  sortOrder           Int      @map("sort_order")
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz

  organization      Organization            @relation(fields: [organizationId], references: [id])
  checklistTemplate ChecklistTemplate       @relation(fields: [checklistTemplateId], references: [id])
  items             ChecklistTemplateItem[]

  @@unique([checklistTemplateId, sortOrder])
  @@index([organizationId, checklistTemplateId])
  @@map("checklist_template_sections")
}

model ChecklistTemplateItem {
  id                         String   @id @default(uuid()) @db.Uuid
  organizationId             String   @map("organization_id") @db.Uuid
  checklistTemplateId        String   @map("checklist_template_id") @db.Uuid
  checklistTemplateSectionId String   @map("checklist_template_section_id") @db.Uuid
  itemType                   String   @map("item_type")
  label                      String
  helpText                   String?  @map("help_text")
  isRequired                 Boolean  @default(true) @map("is_required")
  requiresEvidenceOnFail     Boolean  @default(false) @map("requires_evidence_on_fail")
  requiresCommentOnFail     Boolean  @default(false) @map("requires_comment_on_fail")
  severity                   ChecklistItemSeverity @default(MEDIUM)
  failureCreatesIncident     Boolean  @default(false) @map("failure_creates_incident")
  configJson                 Json?    @map("config_json")
  sortOrder                  Int      @map("sort_order")
  createdAt                  DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                  DateTime @updatedAt @map("updated_at") @db.Timestamptz

  organization             Organization             @relation(fields: [organizationId], references: [id])
  checklistTemplate        ChecklistTemplate        @relation(fields: [checklistTemplateId], references: [id])
  checklistTemplateSection ChecklistTemplateSection @relation(fields: [checklistTemplateSectionId], references: [id])

  @@unique([checklistTemplateSectionId, sortOrder])
  @@index([organizationId, checklistTemplateId])
  @@map("checklist_template_items")
}

model ChecklistSchedule {
  id                        String    @id @default(uuid()) @db.Uuid
  organizationId            String    @map("organization_id") @db.Uuid
  checklistTemplateId       String    @map("checklist_template_id") @db.Uuid
  name                      String
  brandId                   String?   @map("brand_id") @db.Uuid
  locationId                String?   @map("location_id") @db.Uuid
  zoneId                    String?   @map("zone_id") @db.Uuid
  ownerUserId               String?   @map("owner_user_id") @db.Uuid
  timezone                  String
  rrule                     String
  nextRunAt                 DateTime? @map("next_run_at") @db.Timestamptz
  startsAt                  DateTime? @map("starts_at") @db.Timestamptz
  endsAt                    DateTime? @map("ends_at") @db.Timestamptz
  isActive                  Boolean   @default(true) @map("is_active")
  lastGenerationAttemptAt   DateTime? @map("last_generation_attempt_at") @db.Timestamptz
  lastGenerationStatus      String?   @map("last_generation_status")
  lastGenerationError       String?   @map("last_generation_error")
  nextGenerationAttemptAt   DateTime? @map("next_generation_attempt_at") @db.Timestamptz
  createdAt                 DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                 DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  organization      Organization      @relation(fields: [organizationId], references: [id])
  checklistTemplate ChecklistTemplate @relation(fields: [checklistTemplateId], references: [id])
  ownerUser         User?              @relation("ScheduleOwner", fields: [ownerUserId], references: [id])

  @@index([organizationId, isActive, nextRunAt])
  @@index([organizationId, brandId, locationId, zoneId, isActive])
  @@index([isActive, nextRunAt])
  @@map("checklist_schedules")
}

model ChecklistRun {
  id                   String    @id @default(uuid()) @db.Uuid
  organizationId       String    @map("organization_id") @db.Uuid
  checklistTemplateId  String    @map("checklist_template_id") @db.Uuid
  checklistScheduleId  String?   @map("checklist_schedule_id") @db.Uuid
  brandId              String?   @map("brand_id") @db.Uuid
  locationId           String?   @map("location_id") @db.Uuid
  zoneId               String?   @map("zone_id") @db.Uuid
  assignedToUserId     String?   @map("assigned_to_user_id") @db.Uuid
  runSource            String    @default("MANUAL") @map("run_source")
  status               String    @default("PENDING")
  dueAt                DateTime? @map("due_at") @db.Timestamptz
  startedAt            DateTime? @map("started_at") @db.Timestamptz
  completedAt          DateTime? @map("completed_at") @db.Timestamptz
  performedByUserId    String?   @map("performed_by_user_id") @db.Uuid
  runNumber            Int       @map("run_number")
  templateVersion      Int       @map("template_version")
  templateKeySnapshot  String    @map("template_key_snapshot")
  templateNameSnapshot String    @map("template_name_snapshot")
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  organization     Organization                  @relation(fields: [organizationId], references: [id])
  assignedToUser   User?                         @relation("ChecklistRunAssignedToUser", fields: [assignedToUserId], references: [id])
  performedByUser  User?                         @relation("ChecklistRunPerformedByUser", fields: [performedByUserId], references: [id])
  sectionSnapshots ChecklistRunSectionSnapshot[]
  itemSnapshots    ChecklistRunItemSnapshot[]

  @@unique([organizationId, runNumber])
  @@index([organizationId, status, dueAt])
  @@index([organizationId, locationId, zoneId, createdAt])
  @@index([organizationId, checklistTemplateId, createdAt])
  @@map("checklist_runs")
}

model ChecklistRunSectionSnapshot {
  id                         String   @id @default(uuid()) @db.Uuid
  organizationId             String   @map("organization_id") @db.Uuid
  checklistRunId             String   @map("checklist_run_id") @db.Uuid
  checklistTemplateSectionId String?  @map("checklist_template_section_id") @db.Uuid
  titleSnapshot              String   @map("title_snapshot")
  descriptionSnapshot        String?  @map("description_snapshot")
  sortOrder                  Int      @map("sort_order")
  createdAt                  DateTime @default(now()) @map("created_at") @db.Timestamptz

  organization  Organization               @relation(fields: [organizationId], references: [id])
  checklistRun  ChecklistRun               @relation(fields: [checklistRunId], references: [id])
  itemSnapshots ChecklistRunItemSnapshot[]

  @@unique([checklistRunId, sortOrder])
  @@index([organizationId, checklistRunId])
  @@map("checklist_run_section_snapshots")
}

model ChecklistRunItemSnapshot {
  id                             String    @id @default(uuid()) @db.Uuid
  organizationId                 String    @map("organization_id") @db.Uuid
  checklistRunId                 String    @map("checklist_run_id") @db.Uuid
  checklistRunSectionSnapshotId  String    @map("checklist_run_section_snapshot_id") @db.Uuid
  checklistTemplateItemId        String?   @map("checklist_template_item_id") @db.Uuid
  itemTypeSnapshot               String    @map("item_type_snapshot")
  labelSnapshot                  String    @map("label_snapshot")
  helpTextSnapshot               String?   @map("help_text_snapshot")
  isRequiredSnapshot             Boolean   @map("is_required_snapshot")
  requiresEvidenceOnFailSnapshot Boolean   @map("requires_evidence_on_fail_snapshot")
  requiresCommentOnFailSnapshot  Boolean   @map("requires_comment_on_fail_snapshot")
  severitySnapshot               ChecklistItemSeverity @map("severity_snapshot")
  failureCreatesIncidentSnapshot Boolean   @map("failure_creates_incident_snapshot")
  configSnapshotJson             Json?     @map("config_snapshot_json")
  sortOrder                      Int       @map("sort_order")
  result                         String?
  valueJson                      Json?     @map("value_json")
  comment                        String?
  respondedAt                    DateTime? @map("responded_at") @db.Timestamptz
  respondedByUserId              String?   @map("responded_by_user_id") @db.Uuid
  createdAt                      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                      DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  organization                Organization                @relation(fields: [organizationId], references: [id])
  checklistRun                ChecklistRun                @relation(fields: [checklistRunId], references: [id])
  checklistRunSectionSnapshot ChecklistRunSectionSnapshot @relation(fields: [checklistRunSectionSnapshotId], references: [id])
  attachments                 Attachment[]

  @@unique([checklistRunSectionSnapshotId, sortOrder])
  @@index([organizationId, checklistRunId, result], map: "checklist_run_item_snapshots_org_run_result_idx")
  @@index([organizationId, checklistRunId, respondedAt], map: "checklist_run_item_snapshots_org_run_resp_at_idx")
  @@map("checklist_run_item_snapshots")
}

// ---- Audit ----
model AuditLog {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String?  @map("organization_id") @db.Uuid
  actorId        String?  @map("actor_id") @db.Uuid
  entityType     String   @map("entity_type")
  entityId       String   @map("entity_id")
  action         String
  before         Json?
  after          Json?
  ipAddress      String?  @map("ip_address")
  userAgent      String?  @map("user_agent")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  organization Organization? @relation("AuditOrg", fields: [organizationId], references: [id])
  actor        User?         @relation("AuditActor", fields: [actorId], references: [id])

  @@map("audit_logs")
}
