DATABASE_URL="postgresql://user:password@localhost:5432/restaurant_ops"

# Comma-separated emails allowed to call GET /v1/super-admin/* (config-only; not stored in DB).
# SUPER_ADMIN_EMAILS="admin@example.com"
JWT_ACCESS_SECRET="change-me"
JWT_ACCESS_EXPIRES_IN="1h"
JWT_REFRESH_SECRET="change-me-too"
JWT_REFRESH_EXPIRES_IN="7d"
# Instant demo workspace (POST /v1/auth/demo-access). Keep false in production unless intentionally enabled.
DEMO_INSTANT_ACCESS_ENABLED="true"
# Optional: require matching X-Demo-Access-Key header from the frontend when set.
DEMO_INSTANT_ACCESS_KEY="rEm/PXk8jHt3T8+cfGtrKZ1x+YUvVgkp/Zg+yNEMVIo="
# Optional override; default matches prisma seed (demo-explorer@demo.passcontrol.local).
DEMO_INSTANT_USER_EMAIL="demo-explorer@demo.passcontrol.local"
# Required for organization SMTP password encryption. Min 32 characters.
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY="rEm/PXk8jHt3T8+cfGtrKZ1x+YUvVgkp/Zg+yNEMVIo="

# Docker Compose: tag for ghcr.io/sreejith586/passcontrol-backend and passcontrol-frontend (full Git SHA from CI).
IMAGE_TAG=