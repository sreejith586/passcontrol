{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2021",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "incremental": true,
    "tsBuildInfoFile": "./dist/tsconfig.tsbuildinfo",
    "skipLibCheck": true,
    "strictNullChecks": true,
    "noImplicitAny": true,
    "strictBindCallApply": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist", ".git", "frontend", "coverage"],
  "watchOptions": {
    "excludeFiles": [
      "./logfile",
      "logfile",
      "./tsconfig.tsbuildinfo",
      "./tsconfig.build.tsbuildinfo"
    ],
    "excludeDirectories": ["node_modules", "dist", "frontend", "coverage", "uploads"]
  }
}
