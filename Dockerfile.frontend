FROM node:20-alpine AS builder

WORKDIR /app

COPY frontend/package*.json ./
RUN npm install

COPY frontend .

# Ensure env is set for build
ARG VITE_API_BASE_URL=
ARG VITE_POSTHOG_KEY
ARG VITE_POSTHOG_HOST
ARG VITE_GA4_ID

ENV VITE_API_BASE_URL=${VITE_API_BASE_URL}
ENV VITE_POSTHOG_KEY=${VITE_POSTHOG_KEY}
ENV VITE_POSTHOG_HOST=${VITE_POSTHOG_HOST}
ENV VITE_GA4_ID=${VITE_GA4_ID}

RUN test -n "$VITE_API_BASE_URL" && echo "VITE_API_BASE_URL present" || (echo "VITE_API_BASE_URL missing" && exit 1)
RUN test -n "$VITE_POSTHOG_KEY" && echo "VITE_POSTHOG_KEY present" || (echo "VITE_POSTHOG_KEY missing" && exit 1)
RUN test -n "$VITE_POSTHOG_HOST" && echo "VITE_POSTHOG_HOST present" || (echo "VITE_POSTHOG_HOST missing" && exit 1)
RUN test -n "$VITE_GA4_ID" && echo "VITE_GA4_ID present" || (echo "VITE_GA4_ID missing" && exit 1)

RUN npm run build || (echo "BUILD FAILED" && exit 1)

# Production stage
FROM node:20-alpine

WORKDIR /app

RUN npm install -g serve

COPY --from=builder /app/dist ./dist

EXPOSE 5173

CMD ["serve", "-s", "dist", "-l", "5173"]